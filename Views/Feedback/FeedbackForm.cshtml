@model Feedback_Management.Models.Feedback
@{
    ViewData["Title"] = "Feedback Form";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 px-4 pt-4">
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-chat-square-text text-primary me-2"></i>Share Your Feedback</h1>
                <p class="text-muted mb-0">Tell us about your experience.</p>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm("SubmitFeedback", "Feedback", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Name, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-light", placeholder = "Enter Full Name" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light", placeholder = "name@example.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Rating, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-star text-muted"></i></span>
                            @Html.DropDownListFor(m => m.Rating,
                                new SelectList(new[] {
                                    new { Value = 5, Text = "5 - Excellent" },
                                    new { Value = 4, Text = "4 - Very Good" },
                                    new { Value = 3, Text = "3 - Good" },
                                    new { Value = 2, Text = "2 - Fair" },
                                    new { Value = 1, Text = "1 - Poor" }
                                }, "Value", "Text"),
                                "-- Select Rating --",
                                new { @class = "form-select bg-light" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Comments, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Comments, new { @class = "form-control bg-light", rows = 4, placeholder = "Your feedback or suggestions..." })
                        @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex justify-content-between gap-2">
                        <a asp-controller="Feedback" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            Submit Feedback <i class="bi bi-send ms-1"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
